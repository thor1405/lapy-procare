# ========================================================
# LAPY PROCARE - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# Local MongoDB Server: mongodb://127.0.0.1:27017/lapy_procare
# MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/lapy_procare?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/lapy_procare

# JWT Authentication & Cookie Security
JWT_ACCESS_SECRET=lapy_procare_super_secure_jwt_access_secret_key_2026_xyz987
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=lapy_procare_super_secure_jwt_refresh_secret_key_2026_abc123
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=lapy_procare_session_cookie_signature_secret_9999

# Business Profile
BUSINESS_NAME=Lapy Procare
BUSINESS_EMAIL=lapyprocare@gmail.com
BUSINESS_PHONE=+917666104889
BUSINESS_WHATSAPP=917666104889
BUSINESS_ADDRESS=Near St. Joseph Engineering College, Vamanjoor, Mangaluru, Karnataka – 575028, India

# Razorpay Payment Gateway (Optional / Feature-flagged)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
ENABLE_ONLINE_PAYMENTS=false

# AI Troubleshooting Assistant (Server-side OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_AI_ASSISTANT=true

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lapyprocare@gmail.com
SMTP_PASS=
EMAIL_FROM="Lapy Procare <lapyprocare@gmail.com>"
ENABLE_REAL_EMAIL=false

# Official WhatsApp Cloud API (Optional - falls back cleanly to click-to-chat)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

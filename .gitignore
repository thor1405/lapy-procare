# ========================================================
# LAPY PROCARE - GIT IGNORE
# ========================================================

# Dependencies
node_modules/
*/node_modules/

# Production Build Directories
dist/
*/dist/
build/
*/build/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.*
!.env.example
!*/.env.example

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
.idea/
.vscode/
*.swp
*.swo
*~

# Logs & Debuggers
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Coverage
coverage/
*/coverage/
.nyc_output/

# Device Uploads (Preserve directory structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# System Generated / Antigravity Scratch Files
.system_generated/
.gemini/

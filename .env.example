# ========================================================
# LAPY PROCARE - DOCKER & RASPBERRY PI 5 CONFIGURATION
# ========================================================

# ========================================================
# HOST PORTS CONFIGURATION (Custom Ports)
# ========================================================
FRONTEND_PORT=3555
BACKEND_PORT=5065
PORT=5065
NODE_ENV=production

# Base URL (Set to your Raspberry Pi IP:PORT, e.g. http://192.168.1.100:3555 or your custom domain)
CLIENT_URL=http://localhost:3555

# ========================================================
# DATABASE — MONGODB ATLAS CLOUD
# ========================================================
# 1. Create a free M0 cluster on https://cloud.mongodb.com
# 2. Add a Database User (username & password) under 'Database Access'
# 3. Add 0.0.0.0/0 to 'Network Access' (IP Access List)
# 4. Copy your EXACT connection string from: Clusters -> Connect -> Drivers (Node.js)
# NOTE: Atlas clusters have a 5-7 letter subdomain, e.g. cluster0.abc12.mongodb.net
# Do not leave as plain '@cluster0.mongodb.net' or DNS lookup will fail!
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/lapy_procare?retryWrites=true&w=majority

# ========================================================
# SECURITY & AUTHENTICATION SECRETS
# ========================================================
JWT_ACCESS_SECRET=lapy_procare_super_secure_jwt_access_secret_key_2026_xyz987
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=lapy_procare_super_secure_jwt_refresh_secret_key_2026_abc123
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=lapy_procare_session_cookie_signature_secret_9999

# ========================================================
# BUSINESS PROFILE (VAMANJOOR, MANGALURU)
# ========================================================
BUSINESS_NAME="Lapy Procare"
BUSINESS_EMAIL="lapyprocare@gmail.com"
BUSINESS_PHONE="+917666104889"
BUSINESS_WHATSAPP="917666104889"
BUSINESS_ADDRESS="Near St. Joseph Engineering College, Vamanjoor, Mangaluru, Karnataka – 575028, India"

# Optional Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ENABLE_ONLINE_PAYMENTS=false

# Optional AI Assistant API Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_AI_ASSISTANT=true

# Optional SMTP Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lapyprocare@gmail.com
SMTP_PASS=
EMAIL_FROM="Lapy Procare <lapyprocare@gmail.com>"
ENABLE_REAL_EMAIL=false
